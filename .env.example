# Copy this file to .env and fill in your real values.
# NEVER commit .env or paste real keys into chat/AI tools.

PORT=3000
NODE_ENV=development
TRUST_PROXY=false
# Leave blank for same-origin deployment; set to your exact frontend origin if using a separate frontend.
CORS_ORIGIN=

# Estimated Paystack fee used before the actual fee is returned by verification.
PAYSTACK_FEE_RATE=0.0195

# PostgreSQL connection string from your database provider.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set false only if your local PostgreSQL does not use SSL.
DATABASE_SSL=true

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DataHustle
DATAHUSTLE_API_KEY=paste_your_datahustle_api_key_here
DATAHUSTLE_WEBHOOK_SECRET=paste_your_webhook_secret_here
DATAHUSTLE_MOCK_MODE=true

# Admin login. Use a long, unique password.
ADMIN_PASSWORD=replace_with_a_long_random_password
# Used to sign the admin session cookie. Use a different long random value.
ADMIN_SECRET=replace_with_another_long_random_secret
